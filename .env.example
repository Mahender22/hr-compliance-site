# Public origin used by metadata (canonical URL, OG image absolute path,
# robots/sitemap base). Defaults to https://hrcompliance.dev when unset.
NEXT_PUBLIC_SITE_URL=https://hrcompliance.dev

# Where the /waitlist form POSTs.
# Get from https://formspree.io after creating a form.
# When unset, the form falls back to a mailto: link so the page never breaks.
NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/your-form-id
